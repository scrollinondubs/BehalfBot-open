# venice-proxy: holds the Venice API key so opencode-serve never does.
#
# opencode-serve talks to http://venice-proxy:8080/api/v1 with a placeholder
# key; this proxy replaces the Authorization header with the real one. The key
# lives only in this container's environment, so no tool shell in
# opencode-serve can print it (not from env, not from /proc, not from the
# OpenCode API, which returns provider keys in plain text).
#
# Only the two endpoints OpenCode uses are forwarded. Everything else,
# including Venice's API-key management endpoints, gets a 403.
#
# Rendered by the nginx image's envsubst step; only defined environment
# variables (VENICE_API_KEY) are substituted, nginx's own $vars are left alone.

server {
    listen 8080;
    server_tokens off;

    proxy_http_version 1.1;
    proxy_set_header Host api.venice.ai;
    proxy_set_header Connection "";
    proxy_set_header Authorization "Bearer ${VENICE_API_KEY}";
    proxy_ssl_server_name on;
    proxy_ssl_name api.venice.ai;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    client_max_body_size 20m;

    location = /api/v1/chat/completions {
        limit_except POST { deny all; }
        proxy_pass https://api.venice.ai;
    }

    location = /api/v1/models {
        limit_except GET { deny all; }
        proxy_pass https://api.venice.ai;
    }

    location / {
        return 403;
    }
}
