{
  "$schema": "https://opencode.ai/config.json",
  "model": "venice/zai-org-glm-5-2",
  "small_model": "venice/z-ai-glm-5-3-flash",
  "instructions": [
    ".opencode/instructions/response-style.md"
  ],
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "venice": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Venice AI",
      "options": {
        "baseURL": "https://api.venice.ai/api/v1",
        "apiKey": "{env:VENICE_API_KEY}"
      },
      "whitelist": [
        "zai-org-glm-5-2",
        "z-ai-glm-5-3-flash",
        "zai-org-glm-5-1",
        "kimi-k2-7-code",
        "deepseek-v4-pro"
      ],
      "models": {
        "zai-org-glm-5-2": {
          "name": "GLM 5.2"
        },
        "z-ai-glm-5-3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "zai-org-glm-5-1": {},
        "kimi-k2-7-code": {},
        "deepseek-v4-pro": {}
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "*bw-unlock*": "deny",
      "*bw-fetch*": "deny",
      "bw *": "deny",
      "*bitwarden*": "deny",
      "*vaultwarden*": "deny",
      "*security find-generic-password*": "deny",
      "*security add-generic-password*": "deny",
      "*/.behalfbot/scripts/*": "deny",
      "*/.behalfbot/.env*": "deny",
      "*/jax-private/*": "deny",
      "*jax-private*": "deny",
      "cat *.env*": "deny",
      "* .env": "deny",
      "*/.env": "deny",
      "*.env)": "deny",
      "*wacli*": "deny",
      "*whatsapp*": "deny"
    },
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "{env:BEHALFBOT_MEMORY_FILE}"
      }
    },
    "brave-search": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/@brave/brave-search-mcp-server/dist/index.js",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "siyuan": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/siyuan-mcp/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "SIYUAN_URL": "{env:SIYUAN_URL}",
        "SIYUAN_TOKEN": "{env:SIYUAN_TOKEN}"
      }
    },
    "tavily": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/tavily-mcp/build/index.js"
      ],
      "enabled": false,
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/@upstash/context7-mcp/dist/index.js"
      ],
      "enabled": false
    }
  },
  "enabled_providers": [
    "venice"
  ]
}
