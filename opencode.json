{
  "$schema": "https://opencode.ai/config.json",
  "model": "venice/zai-org-glm-5-2",
  "small_model": "venice/z-ai-glm-5-3-flash",
  "enabled_providers": [
    "venice"
  ],
  "shell": "/opt/jill/bin/bash",
  "lsp": false,
  "formatter": false,
  "instructions": [
    "/app/AGENTS.md",
    "/app/.opencode/instructions/response-style.md",
    ".opencode/instructions/response-style.md"
  ],
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "venice": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Venice AI",
      "options": {
        "baseURL": "{env:VENICE_BASE_URL}",
        "apiKey": "not-a-key-venice-proxy-holds-it"
      },
      "whitelist": [
        "zai-org-glm-5-2",
        "z-ai-glm-5-3-flash"
      ],
      "models": {
        "zai-org-glm-5-2": {
          "name": "GLM 5.2"
        },
        "z-ai-glm-5-3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "external_directory": {
      "*": "deny",
      "/workspace/**": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "*bw-unlock*": "deny",
      "*bw-fetch*": "deny",
      "bw *": "deny",
      "*bitwarden*": "deny",
      "*vaultwarden*": "deny",
      "*security find-generic-password*": "deny",
      "*security add-generic-password*": "deny",
      "*/.behalfbot/scripts/*": "deny",
      "*/.behalfbot/.env*": "deny",
      "*/jax-private/*": "deny",
      "*jax-private*": "deny",
      "cat *.env*": "deny",
      "* .env": "deny",
      "*/.env": "deny",
      "*.env)": "deny",
      "*wacli*": "deny",
      "*whatsapp*": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny"
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "{env:BEHALFBOT_MEMORY_FILE}"
      }
    },
    "brave-search": {
      "type": "remote",
      "url": "http://brave-proxy:8080/mcp",
      "enabled": true,
      "oauth": false
    },
    "siyuan": {
      "type": "local",
      "command": [
        "node",
        "/opt/mcp/node_modules/siyuan-mcp/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "SIYUAN_URL": "http://siyuan-proxy:8080"
      }
    }
  }
}
