# BehalfBot-open key names. Copy to .env (gitignored) and fill values.
# NEVER commit real values. opencode auto-loads a project .env at startup;
# scripts/run.sh also sources it.

# --- Model providers -------------------------------------------------------
# Active today (the only key provisioned so far):
ANTHROPIC_API_KEY=

# Open-weight lane - PENDING, see issue #8. When either key lands, the
# provider blocks in opencode.json activate with no other changes:
#   venice-ai/zai-org-glm-5-1, venice-ai/kimi-k2-7-code
#   openrouter/z-ai/glm-5.2, openrouter/moonshotai/kimi-k2-thinking
VENICE_API_KEY=
OPENROUTER_API_KEY=

# --- MCP servers (all enabled:false in opencode.json until keyed) ----------
BRAVE_API_KEY=
GITHUB_PAT=
TAVILY_API_KEY=
OURA_TOKEN=
SIYUAN_URL=
SIYUAN_TOKEN=
TURSO_API_TOKEN=
TURSO_ORGANIZATION=
TURSO_DEFAULT_DATABASE=
N8N_API_URL=
N8N_API_KEY=
REMARKABLE_TOKEN=
PLAYWRIGHT_PROFILE_DIR=

# --- Discord bridge (bridge/discord_bridge.py, see bridge/WIRING.md) -------
DISCORD_BOT_TOKEN=
JAX_OPEN_CHANNEL_ID=
# optional overrides (defaults shown in bridge/WIRING.md):
PRINCIPAL_USER_ID=
OPENCODE_SERVER_URL=
DEFAULT_MODEL=
OPENCODE_PORT=

# --- Local state -----------------------------------------------------------
# Where the memory MCP persists its knowledge graph (default: ./memory/memory.jsonl)
BEHALFBOT_MEMORY_FILE=
