# BehalfBot-open key names. Copy to .env (gitignored) and fill values.
# NEVER commit real values. opencode auto-loads a project .env at startup;
# scripts/run.sh also sources it.

# --- Model provider ---------------------------------------------------------
# Venice is the ONLY provider (BehalfBot-open#46). opencode.json sets
# enabled_providers to ["venice"] and whitelists Venice's private-inference
# models, so a stray ANTHROPIC_API_KEY or OPENROUTER_API_KEY enables nothing.
# In the Docker stack every upstream key goes ONLY to its gateway container
# (venice-proxy, agentmail-proxy, siyuan-proxy, brave-mcp). opencode-serve,
# where tool shells run, holds none of them.
VENICE_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=jill-agent@agentmail.to

# --- Internal secrets: generate each with `openssl rand -hex 32` -----------
# Password for api-proxy, the only way into the opencode serve API. Held by
# the bridge and dispatcher only; opencode-serve itself holds no secrets.
OPENCODE_SERVER_PASSWORD=
# Optional: change if these collide with another Docker network on the host.
# JILL_INTERNAL_SUBNET=10.231.0.0/24
# JILL_INTERNAL_GATEWAY=10.231.0.1
# JILL_API_PROXY_IP=10.231.0.10

# --- MCP servers ------------------------------------------------------------
# Servers are installed in the image at build time (mcp/package-lock.json),
# never fetched with npx at runtime.
# ENABLED in opencode.json (Phase B): brave-search, siyuan. Keys are PENDING -
# Jill gets her own Vaultwarden user; never copy values from Jax's production
# .env. Until these are filled, the two servers show status "failed" in
# GET /mcp and everything else keeps working.
BRAVE_API_KEY=
# SiYuan workspace API base URL, e.g. http://host.docker.internal:6806 from
# the Docker stack (http://127.0.0.1:6806 from the host) + the workspace API
# token (SiYuan Settings > About > API token). READ-ONLY for Jill: all
# mutating siyuan_* tools are blocked by .opencode/plugins/guardrails.ts.
SIYUAN_URL=
SIYUAN_TOKEN=

# Still enabled:false in opencode.json until keyed:
TAVILY_API_KEY=

# --- Matrix chat bridge (matrix-bridge/, see bridge/WIRING.md) ------------
# Jill's chat with Sean, end-to-end encrypted. MATRIX_HOMESERVER and
# MATRIX_PRINCIPAL are shared with the control section below. Jill's access
# token, device keys and the pin of Sean's master key are NOT here: setup
# writes them into the matrix-bridge-state volume.
# Jill's own full Matrix user id (setup logs in as this; the password is
# typed at the prompt, never stored here).
MATRIX_JILL_USER=
# The encrypted room shared by Jill and Sean only: a room id (!id:server).
MATRIX_JILL_ROOM=
# optional overrides (defaults in bridge/WIRING.md):
DEFAULT_MODEL=
BRIDGE_MAX_ATTACHMENT_BYTES=
BRIDGE_MAX_DOC_CHARS=
DRAFT_APPROVAL_TTL=

# --- Heartbeat dispatcher (scheduled-tasks/heartbeat-dispatcher.sh) --------
# See docs/heartbeat-dispatcher.md. All optional - sane defaults apply.
# Attach runs to a long-lived `opencode serve` (kills MCP cold-boot per tick).
# The compose dispatcher service sets this to http://opencode-serve:4747.
OPENCODE_ATTACH_URL=
# HEARTBEATS.md model: aliases -> venice/<model> strings. Defaults:
# venice/zai-org-glm-5-2 (opus, sonnet), venice/z-ai-glm-5-3-flash (haiku).
# Anything that is not venice/<model> is refused by the dispatcher.
HEARTBEAT_MODEL_OPUS=
HEARTBEAT_MODEL_SONNET=
HEARTBEAT_MODEL_HAIKU=
# "0" drops --auto from opencode run (runs may then hang on permission asks)
HEARTBEAT_OPENCODE_AUTO=
# Ollama for `condition: ask_model` (fail-open when unreachable)
OLLAMA_URL=
OLLAMA_MODEL=
# Heartbeat notifications and validator alerts go to the Matrix alerts room
# through the alert spool (docs/control.md); there is nothing to set here.

# --- Control: Matrix kill switch, alerts, credential expiry (docs/control.md)
# Held ONLY by the jill-control container. Jill's container never sees them.
# The control room must NOT be end-to-end encrypted (jill-control holds no
# keys), and it is readable by the homeserver's admin, so alerts there are
# content-free. Room values are ids (!id:server), not aliases.
MATRIX_HOMESERVER=
MATRIX_CONTROL_TOKEN=
# Your own full Matrix user id - the only sender the kill switch and the
# chat bridge obey.
MATRIX_PRINCIPAL=
MATRIX_CONTROL_ROOM=
# Optional: a separate room for alerts (defaults to the control room).
MATRIX_ALERTS_ROOM=
# Gateways whose key probe must report (venice by default; add agentmail,
# siyuan once their keys are set).
CREDENTIAL_EXPECT=
# Non-secret expiry dates for keys that cannot be probed, e.g.
# brave=2027-03-01
CREDENTIAL_EXPIRES=

# --- Venice ceiling at venice-proxy: the main spend control (docs/control.md)
# Hard daily ceiling (default 5), Matrix alert line (default 1), calls in
# flight (4), per minute (30) and per day (2000), and the output-token cap
# that bounds each call's hold (8192).
VENICE_MAX_USD_PER_DAY=
VENICE_ALERT_USD_PER_DAY=
VENICE_MAX_IN_FLIGHT=
VENICE_MAX_REQUESTS_PER_MINUTE=
VENICE_MAX_REQUESTS_PER_DAY=
VENICE_MAX_OUTPUT_TOKENS=

# --- Dispatcher caps (heartbeats are OFF by default; docs/control.md) -------
# Daily spend ceiling across all heartbeats, critical included (default 1,
# alert at 50%).
DISPATCHER_MAX_USD_PER_DAY=
# Per-heartbeat daily run cap when a heartbeat sets none (default 24, 0 = off).
DISPATCHER_DEFAULT_MAX_FIRES_PER_DAY=
# USD per million tokens, model=in:out:cache_read (defaults in docs/control.md).
VENICE_PRICES=

# --- Local state -----------------------------------------------------------
# Where the memory MCP persists its knowledge graph (default: ./memory/memory.jsonl)
BEHALFBOT_MEMORY_FILE=
