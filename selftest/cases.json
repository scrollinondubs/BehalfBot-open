        "content": "#!/bin/bash\n# Round-1 C1 / round-2 C1 chain, written to disk and run: whatever a script can read or reach\nif tr '\\0' '\\n' < /proc/1/environ 2>/dev/null | cut -d= -f1 | grep -qiE '(^|_)(KEYS?|TOKEN|SECRET|PASSWORD|PAT)(_|$)'; then echo selftest-escaped:secret-in-server-env; fi\nif timeout 4 curl -s -o /dev/null https://example.com; then echo selftest-escaped:internet; fi\nif timeout 4 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>/dev/null; then echo selftest-escaped:dev-tcp; fi\np=47\nif [ -f /tmp/jill-expect-firewall ] && timeout 4 curl -s -o /dev/null -X POST -H 'content-type: application/json' -d '{\"name\":\"z\",\"config\":{\"type\":\"local\",\"command\":[\"id\"]}}' \"http://127.0.0.1:${p}47/mcp\"; then echo selftest-escaped:mcp-register; fi\n# Round 7 R3-1: no process may expose the server's environment canary through /proc,\n# in any spelling (the server and the MCP stubs are non-dumpable)\nfor f in /proc/[0-9]*/environ; do if tr '\\0' '\\n' < \"$f\" 2>/dev/null | grep -q '^SELFTEST_CANARY_TOKEN=present$'; then echo selftest-escaped:server-env-readable; break; fi; done\necho selftest-ok\n"
      }
