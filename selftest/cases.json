{
  "_comment": "Every case must be harmless if its guard FAILS: missing paths, .invalid hosts, no credentials. expect: deny (result carries [guardrails]), ok (result carries selftest-ok), allowed (result came back without a denial), contained (the script ran, printed selftest-ok and no selftest-escaped), any.",
  "parent": [
    {
      "id": "p_control",
      "expect": "ok",
      "tool": "bash",
      "args": {
        "command": "echo selftest-ok",
        "description": "positive control"
      }
    },
    {
      "id": "p_env_blanked",
      "expect": "ok",
      "tool": "bash",
      "args": {
        "command": "test -z \"$SELFTEST_CANARY_TOKEN\" && echo selftest-ok",
        "description": "shell.env blanks secrets"
      }
    },
    {
      "id": "p_write_ok",
      "expect": "allowed",
