<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for the headless opencode server.

  1. Replace __REPO_ROOT__ with the absolute path to your BehalfBot-open clone
     (e.g. /Users/you/BehalfBot-open).
  2. Copy to ~/Library/LaunchAgents/com.jax.opencode-serve.plist
  3. launchctl load ~/Library/LaunchAgents/com.jax.opencode-serve.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jax.opencode-serve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/bridge/opencode-serve.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/opencode-serve.launchd.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/opencode-serve.launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
